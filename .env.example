# ---------- Required ----------
# PostgreSQL connection string. Supabase: use the "Session" pooler or direct connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dryharvest?schema=public"

# Public base URL of the site, no trailing slash
APP_URL="http://localhost:3000"
# 32+ random chars. Generate: openssl rand -hex 32
SESSION_SECRET=""

# ---------- Payments: Razorpay (checkout stays disabled until both keys are set) ----------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set in Razorpay Dashboard > Webhooks, pointing at  {APP_URL}/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# ---------- Google sign-in (button hidden until both are set) ----------
# Authorised redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Image storage ----------
# "local" writes to public/uploads (dev / single server only). "s3" works with AWS S3,
# Cloudflare R2 or Supabase Storage (S3 protocol).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public URL prefix for objects, e.g. https://<project>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_URL=""

# ---------- Seed / first admin ----------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# ---------- Scheduled jobs ----------
# Protects /api/cron/release-stale (cancels unpaid orders after 30 min and returns their stock)
CRON_SECRET=""
# Optional: set to "true" if your Postgres requires SSL with a self-signed chain (some hosted providers)
DATABASE_SSL="false"
